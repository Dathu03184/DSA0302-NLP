      ],
      "source": [
        "words = [\"connected\", \"connecting\", \"connection\"]\n",
        "\n",
        "def decompose(word):\n",
        "    rules = {\n",
        "        \"connected\": (\"connect\", \"-ed\"),\n",
        "        \"connecting\": (\"connect\", \"-ing\"),\n",
        "        \"connection\": (\"connect\", \"-ion\")\n",
        "    }\n",
        "    return rules[word]\n",
        "\n",
        "for word in words:\n",
        "    root, suffix = decompose(word)\n",
        "    print(word, \"-> Root:\", root, \"| Suffix:\", suffix)"
      ]
    }
